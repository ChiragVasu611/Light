    <string name="display_environment_studio">Studio</string>
    <string name="display_quality_heading">Default quality</string>
    <string name="display_quality_body">Performance saves battery and runs at 30 fps without shadows. Balanced adds shadows and the beam cone at 60 fps. High quality adds sharper edges and softer shadows.</string>
    <string name="display_quality_performance">Performance</string>
    <string name="display_quality_balanced">Balanced</string>
    <string name="display_quality_high">High quality</string>
    <string name="display_quality_automatic">Not chosen yet. The simulator picks a mode for this device the first time it opens.</string>
    <string name="display_quality_thermal_title">Quality may drop temporarily</string>
    <string name="display_quality_thermal_body">If your device gets hot or battery saver turns on, the simulator switches to Performance until conditions improve.</string>
    <string name="display_motion_heading">Motion</string>
